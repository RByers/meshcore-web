{
  "name": "@meshcore-web/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./util/bytes": {
      "source": "./src/util/bytes.ts",
      "types": "./dist/util/bytes.d.ts",
      "import": "./dist/util/bytes.js"
    },
    "./util/smaz": {
      "source": "./src/util/smaz.ts",
      "types": "./dist/util/smaz.d.ts",
      "import": "./dist/util/smaz.js"
    },
    "./framing": {
      "source": "./src/framing/index.ts",
      "types": "./dist/framing/index.d.ts",
      "import": "./dist/framing/index.js"
    },
    "./transport": {
      "source": "./src/transport/index.ts",
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./util/events": {
      "source": "./src/util/events.ts",
      "types": "./dist/util/events.d.ts",
      "import": "./dist/util/events.js"
    },
    "./util/deferred": {
      "source": "./src/util/deferred.ts",
      "types": "./dist/util/deferred.d.ts",
      "import": "./dist/util/deferred.js"
    },
    "./util/clock": {
      "source": "./src/util/clock.ts",
      "types": "./dist/util/clock.d.ts",
      "import": "./dist/util/clock.js"
    },
    "./protocol": {
      "source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./packet": {
      "source": "./src/packet/index.ts",
      "types": "./dist/packet/index.d.ts",
      "import": "./dist/packet/index.js"
    },
    "./emulator": {
      "source": "./src/emulator/index.ts",
      "types": "./dist/emulator/index.d.ts",
      "import": "./dist/emulator/index.js"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./store": {
      "source": "./src/store/index.ts",
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./app": {
      "source": "./src/app/index.ts",
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
